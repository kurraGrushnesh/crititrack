<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (android:dataExtractionRules).

  Same policy as backup_rules.xml, expressed in the newer format, and
  applied to device-to-device transfer as well as cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="watchlist.hive"/>
        <exclude domain="file" path="watchlist.lock"/>
        <exclude domain="file" path="search_recents.hive"/>
        <exclude domain="file" path="search_recents.lock"/>
        <exclude domain="file" path="settings.hive"/>
        <exclude domain="file" path="settings.lock"/>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="watchlist.hive"/>
        <exclude domain="file" path="search_recents.hive"/>
    </device-transfer>
</data-extraction-rules>
