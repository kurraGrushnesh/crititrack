<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon for spike alerts, referenced by name from the server
  payload in functions/lib/push.js.

  Android tints status-bar icons and discards colour, so this is a plain
  white silhouette with a transparent fill. A coloured icon here renders
  as a featureless white square on the device.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M2,15 L7,15 L10,6 L14,19 L17,11 L22,11"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2" />
</vector>
