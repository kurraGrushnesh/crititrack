<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher-icon foreground: the CritiTrack "tracking" mark — a
  ring with a sentiment pulse across it, in white on the brand-green
  background (see mipmap-anydpi-v26/ic_launcher.xml and
  values/colors.xml). The pulse path is the same shape as the status-bar
  alert icon, scaled and centred.

  108x108 is the adaptive-icon canvas; all art is kept inside the central
  safe zone so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Track ring -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,26 a28,28 0 1 1 0,56 a28,28 0 1 1 0,-56"
        android:strokeColor="#F4F4F2"
        android:strokeAlpha="0.32"
        android:strokeWidth="6" />

    <!-- Sentiment pulse -->
    <path
        android:fillColor="#00000000"
        android:pathData="M30,61.2 L42,61.2 L49.2,39.6 L58.8,70.8 L66,51.6 L78,51.6"
        android:strokeColor="#F4F4F2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="5" />
</vector>
