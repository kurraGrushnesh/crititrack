<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ requires this at runtime before any notification is
         shown. Requested when the user follows their first figure, not at
         launch: a prompt with nothing to justify it is the reliable way
         to be denied permanently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- usesCleartextTraffic="false": the app talks only to its own HTTPS
         backend, and SafeUrl already refuses any non-https link (SEC-06).
         This closes the platform-level route as well.

         Backup and data-extraction rules keep the watchlist and search
         history off cloud backup and device transfer — a backup would
         carry a record of who someone has been reading about into an
         account we do not control. -->
    <application
        android:label="CritiTrack"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Verified App Links: a shared crititrack.app/c/<slug> URL
                 opens the right dashboard instead of a browser. Requires
                 assetlinks.json served at
                 https://crititrack.app/.well-known/assetlinks.json with
                 this app's signing certificate fingerprint; without it
                 Android silently falls back to a chooser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="crititrack.app"
                      android:pathPrefix="/c/"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Used for any message that does not name a channel or icon
             of its own. Ours always do, but a default keeps a future
             message from silently failing to display. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="crititrack_alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_crititrack" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
