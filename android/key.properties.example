# Copy to android/key.properties and fill in. That file is gitignored and
# must never be committed — anyone holding it can sign builds as you.
#
# Generate an upload keystore once:
#
#   keytool -genkey -v -keystore upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Keep the .jks file outside the repository. If you lose it you cannot
# ship an update to an existing listing without Play's key-reset process.

storePassword=
keyPassword=
keyAlias=upload
# Absolute path, or relative to the android/app directory.
storeFile=/absolute/path/to/upload-keystore.jks
