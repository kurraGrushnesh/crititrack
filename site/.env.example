# CritiTrack site — client environment.
#
# Both values are PUBLIC by design: they ship in every browser bundle.
# There are no server-side secrets here — the site is a static export and
# all privileged work happens in the backend, which the browser reaches
# with a Firebase anonymous ID token plus an App Check token minted at
# runtime (see lib/firebase.ts). Nothing in this file is a credential.
#
# Copy to `.env.local` to override the built-in defaults during local dev.

# Analysis backend origin. Default: https://crititrack-api.onrender.com
NEXT_PUBLIC_API_BASE=https://crititrack-api.onrender.com

# Firebase App Check reCAPTCHA Enterprise site key. Registered to the
# crititrack-f7430.web.app / .firebaseapp.com domains (and localhost).
# Default is baked into lib/firebase.ts.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeL-54tAAAAAJstdsua0EMljQuvUvrZOJpEk26_
