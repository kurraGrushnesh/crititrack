rules_version = '2';

// Firestore Security Rules for CritiTrack
//
// All third-party API calls now run in Cloud Functions, and the
// `getCelebrity` / `refreshTrackedCelebrities` functions write celebrity
// data with the Admin SDK -- which bypasses these rules entirely.
// The client therefore only ever READS celebrity data.
//
// This matters because the app signs in anonymously: anyone can obtain a
// uid, so `request.auth != null` is not a meaningful write restriction on
// shared data. Celebrity documents are read-only to every client.
// Rules ensure:
//   1. Only authenticated users (anonymous or signed-in) can read.
//   2. Celebrity data is server-owned: no client may write it.
//   3. Users can only access their own search history.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Celebrity Profiles (server-owned, read-only to clients) ───
    // Written exclusively by Cloud Functions via the Admin SDK, which
    // is not subject to these rules. Denying client writes stops an
    // anonymous user from poisoning the cache every other user reads.
    match /celebrities/{slug} {
      allow read: if request.auth != null;
      allow write: if false;

      match /media_items/{itemId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /sentiment_snapshots/{date} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ── Search History ────────────────────────────────────────────
    // Users can only read/write their own search history document.
    match /search_history/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ── Watchlists ────────────────────────────────────────────────
    // One document per user, keyed by uid, holding the slugs they
    // follow. Same rule as search history: readable and writable only
    // by its owner. Anyone can get a uid by signing in anonymously, so
    // keying on the uid in the path is the restriction that matters.
    match /watchlists/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ── Corrections (server-owned, write-only from clients) ────────
    // A correction report is filed through POST /report-correction,
    // which writes it with the Admin SDK after validating and rate-
    // limiting. Clients never read the collection back — a dispute may
    // name a third party and quote unpublished claims — and never write
    // it directly, so the review queue cannot be flooded past the
    // per-user quota the endpoint enforces.
    match /corrections/{correctionId} {
      allow read, write: if false;
    }

    // ── Rate-limit and budget counters (SEC-02) ───────────────────
    // Written by Cloud Functions with the Admin SDK. A client that could
    // write these could reset its own quota, so nothing may touch them.
    match /usage/{uid} {
      allow read, write: if false;
    }
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // ── Push registrations (F07) ──────────────────────────────────
    // Keyed by a random per-install id rather than by uid, because one
    // account can have several devices whose quiet hours differ.
    //
    // Update requires the uid to match on BOTH the stored row and the
    // incoming one. Checking only the incoming one would let anybody who
    // guessed an install id take over that row by rewriting its uid,
    // which would silently stop the real owner's alerts.
    match /devices/{installId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // ── Deny everything else by default ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
