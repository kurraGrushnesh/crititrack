app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# === SECURITY: API Keys — NEVER commit these ===
.env
*.env
!.env.example

# Release signing — anyone holding these can sign builds as you
android/key.properties
*.jks
*.keystore

# Firebase
# firebase_options.dart holds only public client config (project id, sender id,
# app id, and a Firebase API key that is NOT a secret — access is controlled by
# Security Rules + App Check). It must be committed for the app to initialise.
# google-services.json / GoogleService-Info.plist stay out until Android/iOS CI
# needs them, at which point they are injected from a CI secret.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Gradle cache
android/.gradle/

# Docs (Word files)
android/app/*.docx

# Node
node_modules/
/package-lock.json

# Firebase CLI deploy cache — local build state, not source
.firebase/

# Assembled hosting output — built from site/out and build/web
/dist/

# Coverage report — regenerated by `flutter test --coverage`, and a
# committed copy only ever goes stale against the code it measures.
/coverage/

# Generated overview document — regenerate rather than commit
/CritiTrack-Overview.pdf
